# Copy this file to backend/.env (the real .env is git-ignored; never commit secrets).

# Local development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-in-production

# Leave DATABASE_URL unset to use a local SQLite file (backend/db.sqlite3).
# To use Supabase / PostgreSQL instead, set the connection string:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Only needed on a custom domain / hosted deployment:
# ALLOWED_HOSTS=.onrender.com,example.com
# CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://example.com
